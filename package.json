{
  "name": "tanstack-federation-pr-lab",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "doctor": "node scripts/doctor.mjs",
    "dev": "node scripts/run.mjs dev",
    "build": "node scripts/run.mjs build",
    "preview": "node scripts/run.mjs preview",
    "typecheck": "npm run typecheck --workspaces",
    "typecheck:federation": "tsc --project tsconfig.federation.json",
    "test": "node scripts/test.mjs preview",
    "test:dev": "node scripts/test.mjs dev",
    "test:unit": "rstest run tests/unit.test.ts tests/doctor.test.ts tests/insights.test.ts tests/remote-errors.test.ts",
    "test:federation": "rstest run --config rstest.federation.config.ts",
    "test:components": "rstest run --config rstest.components.config.ts",
    "test:coverage": "rstest run --config rstest.coverage.config.ts",
    "coverage:summary": "node scripts/coverage-summary.mjs",
    "test:advanced": "node scripts/test.mjs preview tests/advanced.test.ts",
    "test:multi": "node scripts/test.mjs preview tests/legacy.test.ts",
    "test:multi:dev": "node scripts/test.mjs dev tests/legacy.test.ts",
    "lint": "rslint .",
    "lint:fix": "rslint --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@module-federation/rstest": "2.9.3",
    "@module-federation/tanstack": "0.4.0",
    "@rsbuild/plugin-react": "2.1.1",
    "@rslint/core": "^0.10.1",
    "@rstest/core": "^0.12.6",
    "@rstest/coverage-istanbul": "0.12.6",
    "@rstest/playwright": "^0.12.6",
    "@tailwindcss/postcss": "^4.3.5",
    "@tanstack/start-storage-context": "1.167.41",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.12",
    "@types/node": "26.6.6",
    "@types/react": "19.3.1",
    "@types/react-dom": "19.3.0",
    "jsdom": "31.0.1",
    "playwright": "^1.65.0",
    "prettier": "^3.10.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "7.0.2"
  }
}
