{
  "name": "tanstack-federation-pr-lab",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "node scripts/run.mjs dev",
    "build": "node scripts/run.mjs build",
    "preview": "node scripts/run.mjs preview",
    "typecheck": "npm run typecheck --workspaces",
    "test": "node scripts/run.mjs test",
    "test:dev": "node scripts/run.mjs test:dev",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4.3.5",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0"
  }
}
